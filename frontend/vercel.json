{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "YOUR_RAILWAY_BACKEND_URL/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "YOUR_RAILWAY_BACKEND_URL/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
